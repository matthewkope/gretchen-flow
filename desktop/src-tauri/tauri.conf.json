{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gretchen Flow",
  "version": "0.3.0",
  "identifier": "com.matthewkope.gretchenflow",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "bash scripts/build-parakeet.sh",
    "beforeDevCommand": {
      "script": "bash scripts/build-parakeet.sh",
      "wait": true
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../parakeet/staging/": "parakeet/"
    }
  }
}
