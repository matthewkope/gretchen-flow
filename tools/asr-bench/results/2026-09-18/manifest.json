[
  {
    "id": "1272-128104-0000",
    "path": "1272-128104-0000.f32",
    "text": "MISTER QUILTER IS THE APOSTLE OF THE MIDDLE CLASSES AND WE ARE GLAD TO WELCOME HIS GOSPEL",
    "seconds": 5.855,
    "speaker_id": 1272,
    "sha256": "22d472b40f913206b6917115d136306be88df3b278e77f68be5910423250fa4d"
  },
  {
    "id": "1272-128104-0003",
    "path": "1272-128104-0003.f32",
    "text": "HE HAS GRAVE DOUBTS WHETHER SIR FREDERICK LEIGHTON'S WORK IS REALLY GREEK AFTER ALL AND CAN DISCOVER IN IT BUT LITTLE OF ROCKY ITHACA",
    "seconds": 9.9,
    "speaker_id": 1272,
    "sha256": "1f53178fb87479e7b950d00cfab43710a82bd79ce06be7dc859da073e7d812ea"
  },
  {
    "id": "1272-128104-0006",
    "path": "1272-128104-0006.f32",
    "text": "ON THE GENERAL PRINCIPLES OF ART MISTER QUILTER WRITES WITH EQUAL LUCIDITY",
    "seconds": 5.64,
    "speaker_id": 1272,
    "sha256": "4527da7d3bcfb27a1647e01d77a5c0548bfa09094c86d8a52b83ce31f436b1b0"
  },
  {
    "id": "1272-128104-0009",
    "path": "1272-128104-0009.f32",
    "text": "HE LAMENTS MOST BITTERLY THE DIVORCE THAT HAS BEEN MADE BETWEEN DECORATIVE ART AND WHAT WE USUALLY CALL PICTURES MAKES THE CUSTOMARY APPEAL TO THE LAST JUDGMENT AND REMINDS US THAT IN THE GREAT DAYS OF ART MICHAEL ANGELO WAS THE FURNISHING UPHOLSTERER",
    "seconds": 18.29,
    "speaker_id": 1272,
    "sha256": "e6d926f2892b222f05bc1cf7202b66dda615308fb474dfba35f9ddef324ec584"
  },
  {
    "id": "1272-128104-0012",
    "path": "1272-128104-0012.f32",
    "text": "ONLY UNFORTUNATELY HIS OWN WORK NEVER DOES GET GOOD",
    "seconds": 5.38,
    "speaker_id": 1272,
    "sha256": "7c8fe2b25bc00f4d8677f7bebe2b231a83fdbfcce297c836d9389afa9a86d4e6"
  },
  {
    "id": "1272-135031-0000",
    "path": "1272-135031-0000.f32",
    "text": "BECAUSE YOU WERE SLEEPING INSTEAD OF CONQUERING THE LOVELY ROSE PRINCESS HAS BECOME A FIDDLE WITHOUT A BOW WHILE POOR SHAGGY SITS THERE A COOING DOVE",
    "seconds": 10.885,
    "speaker_id": 1272,
    "sha256": "6fcec499422088809d8ed636c76d5cff82fd081aa2d4ce1dea41c2692da5e5f7"
  },
  {
    "id": "1272-135031-0003",
    "path": "1272-135031-0003.f32",
    "text": "THE LITTLE GIRL HAD BEEN ASLEEP BUT SHE HEARD THE RAPS AND OPENED THE DOOR",
    "seconds": 4.755,
    "speaker_id": 1272,
    "sha256": "518ba8171c4a0fcff7fad5b0fbc2de1c3e20aa3503cafcb7fc963482fc0c979e"
  },
  {
    "id": "1272-135031-0006",
    "path": "1272-135031-0006.f32",
    "text": "I ALSO OFFERED TO HELP YOUR BROTHER TO ESCAPE BUT HE WOULD NOT GO",
    "seconds": 4.09,
    "speaker_id": 1272,
    "sha256": "c3efc40f43f49369970a59c02d168cf458db911e18519e921276562dbd1cd60e"
  },
  {
    "id": "1272-135031-0010",
    "path": "1272-135031-0010.f32",
    "text": "IN FACT THERE IS NOTHING HE CAN DO IN THESE DOMINIONS AS WELL AS OUR NOMES WHOSE NUMBERS ARE SO GREAT THAT IT WORRIES US TO KEEP THEM ALL BUSY",
    "seconds": 8.995,
    "speaker_id": 1272,
    "sha256": "422d38e246e43815b6e6ffefda359cb96549694a9a49d4b40f5d1b3ecf306715"
  },
  {
    "id": "1272-135031-0013",
    "path": "1272-135031-0013.f32",
    "text": "INQUIRED SHAGGY IN THE METAL FOREST",
    "seconds": 3.7,
    "speaker_id": 1272,
    "sha256": "3667bac439c380aacba0f4453aac2a39b0734002077e7705d824a603fc4262f4"
  },
  {
    "id": "1272-135031-0016",
    "path": "1272-135031-0016.f32",
    "text": "KALIKO HESITATED",
    "seconds": 2.28,
    "speaker_id": 1272,
    "sha256": "88edba217bebe46bcbcf89fffe1691cbd571695300b1678259a0e375263d3f13"
  },
  {
    "id": "1272-135031-0019",
    "path": "1272-135031-0019.f32",
    "text": "THAT'S FUNNY REMARKED BETSY THOUGHTFULLY",
    "seconds": 3.525,
    "speaker_id": 1272,
    "sha256": "351c8bf5c8ac57e786c968c97492adbef924fae26841c41a7e88e42262af5eaf"
  },
  {
    "id": "1272-135031-0022",
    "path": "1272-135031-0022.f32",
    "text": "TRUE AGREED KALIKO",
    "seconds": 2.695,
    "speaker_id": 1272,
    "sha256": "762017d027aab4e13b392ef84f23a3f2f4cceab943df461aaf5ebeb998313af7"
  },
  {
    "id": "1272-141231-0000",
    "path": "1272-141231-0000.f32",
    "text": "A MAN SAID TO THE UNIVERSE SIR I EXIST",
    "seconds": 4.65,
    "speaker_id": 1272,
    "sha256": "fa26ece47664eaa40c57b027512de0e3670aa353b8e42c044346b084cb9831fd"
  },
  {
    "id": "1272-141231-0003",
    "path": "1272-141231-0003.f32",
    "text": "HIS INSTANT OF PANIC WAS FOLLOWED BY A SMALL SHARP BLOW HIGH ON HIS CHEST",
    "seconds": 5.42,
    "speaker_id": 1272,
    "sha256": "df5b569509f71f89de3d00a7721975023cc301b841c151fe27304a0452b55a11"
  },
  {
    "id": "1272-141231-0006",
    "path": "1272-141231-0006.f32",
    "text": "THE BUZZER'S WHIRR TRIGGERED HIS MUSCLES INTO COMPLETE RELAXATION",
    "seconds": 4.93,
    "speaker_id": 1272,
    "sha256": "e6a3fc832bff134ab71f69f56e53c6bebe2d16b73a4385dcb7e611ca2d6106e3"
  },
  {
    "id": "1272-141231-0010",
    "path": "1272-141231-0010.f32",
    "text": "PARTICULARLY SO ON THIS LAST NIGHT WHEN ONLY TWO OF THE LITTLE CUBICLES WERE OCCUPIED THE THOUSANDS OF OTHERS STANDING WITH DARK EMPTY DOORS",
    "seconds": 10.76,
    "speaker_id": 1272,
    "sha256": "930ecf5a5de4822af7d7ab194220fc695432f2e1afa671d435435a5b1ac5f7cd"
  },
  {
    "id": "1272-141231-0013",
    "path": "1272-141231-0013.f32",
    "text": "THE TWENTIES",
    "seconds": 1.6399375,
    "speaker_id": 1272,
    "sha256": "a0a3ae1ea5878c213df639296e9f4c3fb8a4d6525fdd50a013cb87f515bb6a46"
  },
  {
    "id": "1272-141231-0016",
    "path": "1272-141231-0016.f32",
    "text": "TEN SECONDS",
    "seconds": 1.85,
    "speaker_id": 1272,
    "sha256": "72185205d25a7c0856d65b50bc8c38d7b66bff6586eab9a3e08ae17e5e4c42db"
  },
  {
    "id": "1272-141231-0019",
    "path": "1272-141231-0019.f32",
    "text": "THERE COULD BE LITTLE ART IN THIS LAST AND FINAL ROUND OF FENCING",
    "seconds": 4.7,
    "speaker_id": 1272,
    "sha256": "eb4bd6e31118d4503be80f139becb1b9acbaef2d84dbf0f1efa1bd6c32f5ffa9"
  },
  {
    "id": "1272-141231-0022",
    "path": "1272-141231-0022.f32",
    "text": "THERE APPEARED TO BE AN IMMEDIATE ASSOCIATION WITH THE DEATH TRAUMA AS IF THE TWO WERE INEXTRICABLY LINKED INTO ONE",
    "seconds": 8.35,
    "speaker_id": 1272,
    "sha256": "abf3396562136f2f370d834b8f881adb42950bf98147ee5875dc24388d132ae1"
  },
  {
    "id": "1272-141231-0025",
    "path": "1272-141231-0025.f32",
    "text": "OTHERS HAD DIED BEFORE DURING THE TWENTIES AND DEATH DURING THE LAST ROUND WAS IN SOME WAYS EASIER THAN DEFEAT",
    "seconds": 8.725,
    "speaker_id": 1272,
    "sha256": "1751c343220036225785f69383bbb70f58d4caf27b6bf16ff7c13fc7bd1f531f"
  },
  {
    "id": "1272-141231-0028",
    "path": "1272-141231-0028.f32",
    "text": "IROLG LOOKED AMAZED AT THE SUDDEN FURY OF THE ATTACK THEN SMILED",
    "seconds": 5.65,
    "speaker_id": 1272,
    "sha256": "49d2a8ef600e4e5e8f98ef270c31c474824daef75d902ec38b3eef72a850aded"
  },
  {
    "id": "1272-141231-0032",
    "path": "1272-141231-0032.f32",
    "text": "THEN THE POWERFUL TWIST THAT THRUST IT ASIDE IN AND UNDER THE GUARD",
    "seconds": 4.48,
    "speaker_id": 1272,
    "sha256": "51a0684effb649472706aa913b45ab046047d69623a22b1875a4f075386836de"
  }
]
